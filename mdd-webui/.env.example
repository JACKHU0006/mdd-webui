# Base URL of the MDD control plane.
#
#   empty string  -> same origin. Correct for production behind the Cloudflare Worker
#                    (the Worker proxies /api and /ws to the tunnel) and for the local
#                    Vite proxy in dev.
#   full URL      -> cross-origin. Only works if the control plane sends
#                    Access-Control-Allow-Credentials and the session cookie is relaxed.
#                    NOT recommended: mdd_session is SameSite=Strict, so a cross-site
#                    browser request will simply not carry it.
VITE_API_BASE=

# Shown in the UI footer so an operator can tell a demo deployment from a real one.
VITE_DEMO_MODE=0

# Base URL for the WebSocket. Defaults to VITE_API_BASE with ws:// or wss://.
# Leave empty to derive from window.location.
VITE_WS_BASE=
